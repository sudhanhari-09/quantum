# QSC Platform backend environment (copy to .env and edit)
QSC_ENV=dev
LOG_LEVEL=INFO

# Database: SQLite for dev/test, PostgreSQL URL for prod
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/qsc
DATABASE_URL=sqlite:///./qsc.db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Master key for encrypting QKD-derived keys at rest (32 random bytes, base64).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
QSC_MASTER_KEY=

# Simulation defaults
THRESHOLD_DEFAULT=0.11
CHANNEL_NOISE_DEFAULT=0.01
QKD_QUBITS_DEFAULT=256
MAX_REATTACKS=3

# Pipeline scheduling: PROCESS_ASYNC=true -> POST /messages returns 202/CREATED
# immediately; the secure pipeline continues as a background task with
# PIPELINE_STAGE_DELAY_MS dwell per stage, creating the live attack window.
PROCESS_ASYNC=false
PIPELINE_STAGE_DELAY_MS=1200

# Rate limits (per minute)
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_SEARCH_PER_MIN=10
RATE_LIMIT_ATTACK_PER_MIN=3
RATE_LIMIT_DEFAULT_PER_MIN=120

# CORS comma-separated allowlist
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Bootstrap admin + eve accounts (run once with ENABLE_ADMIN_BOOTSTRAP=true)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=admin@qsc.local
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
